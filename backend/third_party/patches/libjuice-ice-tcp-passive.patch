+static nfds_t tcp_passive_process(juice_agent_t *agent, pfds_record_t *pfds, nfds_t i) {
+	conn_impl_t *conn_impl = agent->conn_impl;
+	struct pollfd *listen_pfd = NULL;
+	if (conn_impl->polled_listen && i < pfds->size)
+		listen_pfd = pfds->pfds + i++;
+
+	int polled = conn_impl->polled_pending;
+	for (int k = 0; k < polled && i < pfds->size; ++k) {
+		struct pollfd *pending_pfd = pfds->pfds + i++;
+		if (pending_pfd->revents && conn_impl->state != CONN_STATE_FINISHED)
+			tcp_passive_read(agent, pending_pfd);
+	}
+
+	// Accepted last: a connection it closes to make room may have a descriptor polled above,
+	// whose number a new one could reuse
+	if (listen_pfd && conn_impl->listen_sock != INVALID_SOCKET &&
+	    listen_pfd->fd == conn_impl->listen_sock && (listen_pfd->revents & POLLIN) &&
+	    conn_impl->state != CONN_STATE_FINISHED)
+		tcp_passive_accept(agent);
+	return i;
+}
