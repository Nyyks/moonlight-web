+	for (int k = conn_impl->pending_count - 1; k >= 0; --k) {
+		if (conn_impl->pending[k].deadline <= now) {
+			JLOG_INFO("Passive ICE-TCP: no first frame in time, closing the connection");
+			tcp_passive_drop(conn_impl, k);
+		}
+	}
