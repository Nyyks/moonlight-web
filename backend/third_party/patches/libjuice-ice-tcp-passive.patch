+// The oldest waiting connection from `src` (any port), or, with NULL, the oldest one that has not
+// sent a byte; -1 if there is none. The oldest has the earliest deadline.
+static int tcp_passive_oldest(const conn_impl_t *conn_impl, const addr_record_t *src) {
+	int oldest = -1;
+	for (int k = 0; k < conn_impl->pending_count; ++k) {
+		const tcp_passive_pending_t *pending = conn_impl->pending + k;
+		bool match = src ? addr_is_equal((const struct sockaddr *)&pending->src.addr,
+		                                 (const struct sockaddr *)&src->addr, false)
+		                 : pending->received == 0;
+		if (match && (oldest < 0 || pending->deadline < conn_impl->pending[oldest].deadline))
+			oldest = k;
+	}
+	return oldest;
+}
