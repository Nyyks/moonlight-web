+static void tcp_passive_accept(juice_agent_t *agent) {
+	conn_impl_t *conn_impl = agent->conn_impl;
+	// Bounded: whatever is left waits for the next poll
+	for (int left = 2 * TCP_PASSIVE_PENDING_MAX; left > 0; --left) {
+		addr_record_t src;
+		memset(&src, 0, sizeof(src));
+		src.len = sizeof(src.addr);
+		socket_t sock = accept(conn_impl->listen_sock, (struct sockaddr *)&src.addr, &src.len);
+		if (sock == INVALID_SOCKET)
+			return; // none left, or an error the next poll reports again
+
+		addr_unmap_inet6_v4mapped((struct sockaddr *)&src.addr, &src.len);
+		src.socktype = SOCK_STREAM;
+
+		// One address keeps at most TCP_PASSIVE_PER_ADDRESS_MAX places, its newest connection
+		// taking its oldest one's; a full list makes room by closing its oldest silent connection,
+		// one that has not sent a byte. A peer dials and sends its check at once, so whoever fills
+		// the places can no longer keep it out.
+		int same = 0;
+		for (int k = 0; k < conn_impl->pending_count; ++k)
+			if (addr_is_equal((const struct sockaddr *)&conn_impl->pending[k].src.addr,
+			                  (const struct sockaddr *)&src.addr, false))
+				++same;
+		if (same >= TCP_PASSIVE_PER_ADDRESS_MAX) {
+			JLOG_INFO("Passive ICE-TCP: too many connections waiting from one address, closing its "
+			          "oldest");
+			tcp_passive_drop(conn_impl, tcp_passive_oldest(conn_impl, &src));
+		} else if (conn_impl->pending_count >= TCP_PASSIVE_PENDING_MAX) {
+			int silent = tcp_passive_oldest(conn_impl, NULL);
+			if (silent < 0) {
+				// Accepted only to leave the kernel's queue: it takes no place a peer is using
+				JLOG_INFO("Passive ICE-TCP: too many connections waiting, closing a new one");
+				closesocket(sock);
+				continue;
+			}
+			JLOG_INFO("Passive ICE-TCP: too many connections waiting, closing the oldest silent one");
+			tcp_passive_drop(conn_impl, silent);
+		}
+
+		ctl_t nbio = 1;
+		if (ioctlsocket(sock, FIONBIO, &nbio)) {
+			closesocket(sock);
+			continue;
+		}
+
+		tcp_passive_pending_t *pending = conn_impl->pending + conn_impl->pending_count++;
+		pending->sock = sock;
+		pending->src = src;
+		pending->deadline = current_timestamp() + TCP_PASSIVE_FIRST_FRAME_TIMEOUT;
+		pending->length = 0;
+		pending->received = 0;
+
+		if (JLOG_DEBUG_ENABLED) {
+			char src_str[ADDR_MAX_STRING_LEN];
+			addr_record_to_string(&src, src_str, ADDR_MAX_STRING_LEN);
+			JLOG_DEBUG("Passive ICE-TCP: accepted a connection from %s", src_str);
+		}
+	}
+}
