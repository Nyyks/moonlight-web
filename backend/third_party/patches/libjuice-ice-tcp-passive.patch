+static void tcp_queue_reset(conn_impl_t *conn_impl) {
+	free(conn_impl->tcp_queue);
+	conn_impl->tcp_queue = NULL;
+	conn_impl->tcp_queue_start = conn_impl->tcp_queue_end = 0;
+}
+
+// Under the send mutex. False when it does not fit: the caller drops it.
+static bool tcp_queue_push(conn_impl_t *conn_impl, const char *data, size_t size) {
+	size_t used = conn_impl->tcp_queue_end - conn_impl->tcp_queue_start;
+	if (used + 2 + size > TCP_SEND_QUEUE_MAX)
+		return false;
+
+	if (!conn_impl->tcp_queue && !(conn_impl->tcp_queue = malloc(TCP_SEND_QUEUE_MAX)))
+		return false;
+
+	if (conn_impl->tcp_queue_end + 2 + size > TCP_SEND_QUEUE_MAX) {
+		memmove(conn_impl->tcp_queue, conn_impl->tcp_queue + conn_impl->tcp_queue_start, used);
+		conn_impl->tcp_queue_start = 0;
+		conn_impl->tcp_queue_end = used;
+	}
+	uint16_t header = htons((uint16_t)size); // RFC 4571 framing, as tcp_ice_write() does
+	memcpy(conn_impl->tcp_queue + conn_impl->tcp_queue_end, &header, 2);
+	memcpy(conn_impl->tcp_queue + conn_impl->tcp_queue_end + 2, data, size);
+	conn_impl->tcp_queue_end += 2 + size;
+	return true;
+}
+
+// Under the send mutex, once tcp_ice_write() holds nothing: as much of the queue as the socket
+// takes. 0, or -errno on a failure other than would-block.
+static int tcp_queue_flush(conn_impl_t *conn_impl) {
+#if defined(__APPLE__) || defined(_WIN32)
+	int flags = 0;
+#else
+	int flags = MSG_NOSIGNAL;
+#endif
+	while (conn_impl->tcp_queue_start < conn_impl->tcp_queue_end) {
+		int len = send(conn_impl->tcp_sock, conn_impl->tcp_queue + conn_impl->tcp_queue_start,
+		               (int)(conn_impl->tcp_queue_end - conn_impl->tcp_queue_start), flags);
+		if (len < 0) {
+			int err = sockerrno;
+			return err == SEAGAIN || err == SEWOULDBLOCK ? 0 : -err;
+		}
+		conn_impl->tcp_queue_start += (size_t)len;
+	}
+	conn_impl->tcp_queue_start = conn_impl->tcp_queue_end = 0;
+	return 0;
+}
