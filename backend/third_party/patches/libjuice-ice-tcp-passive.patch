+// Under the registry lock, before each poll: the listener closes once the checks are over, and
+// a connection that did not send its first frame in time is closed.
+static void tcp_passive_trim(juice_agent_t *agent, timestamp_t now) {
+	conn_impl_t *conn_impl = agent->conn_impl;
+	if (conn_impl->listen_sock == INVALID_SOCKET && conn_impl->pending_count == 0)
+		return;
+
+	if (agent->state == JUICE_STATE_COMPLETED || agent->state == JUICE_STATE_FAILED ||
+	    conn_impl->tcp_passive) {
+		tcp_passive_close(conn_impl);
+		return;
+	}
