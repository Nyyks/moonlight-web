+static socket_t tcp_passive_listen(socket_t udp_sock) {
+	addr_record_t name;
+	memset(&name, 0, sizeof(name));
+	name.len = sizeof(name.addr);
+	if (getsockname(udp_sock, (struct sockaddr *)&name.addr, &name.len) != 0) {
+		JLOG_WARN("Passive ICE-TCP: getsockname failed, errno=%d", sockerrno);
+		return INVALID_SOCKET;
+	}
+	uint16_t port = addr_get_port((struct sockaddr *)&name.addr);
+
+	socket_t sock = socket(name.addr.ss_family, SOCK_STREAM, IPPROTO_TCP);
+	if (sock == INVALID_SOCKET) {
+		JLOG_WARN("Passive ICE-TCP: socket creation failed, errno=%d", sockerrno);
+		return INVALID_SOCKET;
+	}
+
+	const sockopt_t disabled = 0;
+	if (name.addr.ss_family == AF_INET6) // dual-stack, like the UDP socket
+		setsockopt(sock, IPPROTO_IPV6, IPV6_V6ONLY, (const char *)&disabled, sizeof(disabled));
+#ifndef _WIN32
+	// A connection of the previous session may sit in TIME_WAIT on this port. This lets the
+	// listener bind regardless; it never lets two listeners share the port.
+	const sockopt_t enabled = 1;
+	setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, (const char *)&enabled, sizeof(enabled));
+#endif
+
+	ctl_t nbio = 1;
+	if (ioctlsocket(sock, FIONBIO, &nbio)) {
+		JLOG_WARN("Passive ICE-TCP: setting non-blocking mode failed, errno=%d", sockerrno);
+		goto error;
+	}
+	if (bind(sock, (const struct sockaddr *)&name.addr, name.len) != 0) {
+		JLOG_INFO("Passive ICE-TCP: cannot bind TCP port %hu, errno=%d, no passive candidate", port,
+		          sockerrno);
+		goto error;
+	}
+	if (listen(sock, TCP_PASSIVE_PENDING_MAX) != 0) {
+		JLOG_WARN("Passive ICE-TCP: listen failed on port %hu, errno=%d", port, sockerrno);
+		goto error;
+	}
+
+	JLOG_INFO("Passive ICE-TCP: listening on TCP port %hu", port);
+	return sock;
+
+error:
+	closesocket(sock);
+	return INVALID_SOCKET;
+}
+
+static void tcp_passive_close(conn_impl_t *conn_impl) {
+	if (conn_impl->listen_sock != INVALID_SOCKET) {
+		JLOG_DEBUG("Passive ICE-TCP: closing the listener");
+		closesocket(conn_impl->listen_sock);
+		conn_impl->listen_sock = INVALID_SOCKET;
+	}
+	while (conn_impl->pending_count > 0)
+		tcp_passive_drop(conn_impl, conn_impl->pending_count - 1);
+}
+
+static void tcp_passive_drop(conn_impl_t *conn_impl, int k) {
+	closesocket(conn_impl->pending[k].sock);
+	--conn_impl->pending_count;
+	if (k != conn_impl->pending_count)
+		conn_impl->pending[k] = conn_impl->pending[conn_impl->pending_count];
+}
