+static void tcp_passive_read(juice_agent_t *agent, struct pollfd *pfd) {
+	conn_impl_t *conn_impl = agent->conn_impl;
+	int k = 0;
+	while (k < conn_impl->pending_count && conn_impl->pending[k].sock != pfd->fd)
+		++k;
+	if (k == conn_impl->pending_count)
+		return; // closed since the poll
+
+	if (pfd->revents & (POLLERR | POLLNVAL) || (pfd->revents & POLLHUP && !(pfd->revents & POLLIN))) {
+		tcp_passive_drop(conn_impl, k);
+		return;
+	}
+	if (!(pfd->revents & POLLIN))
+		return;
+
+	tcp_passive_pending_t *pending = conn_impl->pending + k;
+	while (pending->received < 2 || pending->received < 2 + pending->length) {
+		size_t want = pending->received < 2 ? 2 : 2 + (size_t)pending->length;
+		int len = recv(pending->sock, pending->buffer + pending->received,
+		               (int)(want - pending->received), 0);
+		if (len < 0 && (sockerrno == SEAGAIN || sockerrno == SEWOULDBLOCK))
+			return; // the rest comes later, or the deadline closes it
+		if (len <= 0) {
+			tcp_passive_drop(conn_impl, k); // closed, or failed
+			return;
+		}
+
+		pending->received += (uint16_t)len;
+		if (pending->received == 2) {
+			uint16_t header;
+			memcpy(&header, pending->buffer, 2);
+			pending->length = ntohs(header);
+			if (pending->length < TCP_PASSIVE_FIRST_FRAME_MIN ||
+			    pending->length > TCP_PASSIVE_FIRST_FRAME_MAX) {
+				JLOG_INFO("Passive ICE-TCP: a first frame of %hu bytes, closing", pending->length);
+				tcp_passive_drop(conn_impl, k);
+				return;
+			}
+		}
+	}
+
+	tcp_passive_adopt(agent, k);
+}
